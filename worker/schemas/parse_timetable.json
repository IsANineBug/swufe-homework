{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["slots"],
  "properties": {
    "slots": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "room", "weekday", "start", "end", "truncated", "start_visible"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 60},
          "room": {"type": ["string", "null"], "minLength": 1, "maxLength": 40},
          "weekday": {"type": "integer", "minimum": 1, "maximum": 5},
          "start": {"type": "integer", "minimum": 1, "maximum": 12},
          "end": {"type": "integer", "minimum": 1, "maximum": 12},
          "truncated": {"type": "boolean"},
          "start_visible": {"type": "boolean"}
        }
      }
    }
  }
}
