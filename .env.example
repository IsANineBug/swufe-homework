# 复制为 .env 后填写。不要提交 .env。
# 服务器：cp .env.example deploy/.env，只需填「server」「deploy」两段；
# 电脑端 worker：cp .env.example worker/.env，只需填「worker」段。
# 随机值可用：openssl rand -base64 48 | tr -d '\n/+='

# ---- server ----
POSTGRES_DB=homework
POSTGRES_USER=homework
POSTGRES_PASSWORD=CHANGE_ME
# 密码须与 POSTGRES_PASSWORD 一致；含特殊字符时做 URL 编码
DATABASE_URL=postgres://homework:CHANGE_ME@postgres:5432/homework?sslmode=disable
# server 监听地址（裁决 #4-2：统一用 HTTP_ADDR）
HTTP_ADDR=:8080
JWT_SECRET=CHANGE_ME_64_RANDOM_CHARS
# 电脑端 worker 的令牌，≥ 24 位随机串；留空或仍为 CHANGE_ME 占位 = 不启用 AI（worker 段填同一个值）
WORKER_TOKEN=CHANGE_ME_LONG_RANDOM
# 首个管理员注册后可清空并重启 server
BOOTSTRAP_ADMIN_TOKEN=CHANGE_ME_ONE_TIME
UPLOAD_DIR=/data/uploads
# 文件 URL 过期签名密钥（/files 链接与 AI 任务的图片共用）
FILE_URL_SECRET=CHANGE_ME
TZ=Asia/Shanghai
# 可选：三个同时填则固定以此为当前学期（YYYY-MM-DD），不再自动切换，每学期要手动改；
# 留空按校历自动推算（秋 9/1–次年 2/1，春 3/1–8/1）。server 启动时自动创建学期（裁决 #4-12）
SEMESTER_NAME=
SEMESTER_STARTS_ON=
SEMESTER_ENDS_ON=
# 可选：同一 IP 每小时注册次数（默认 30）、日志级别
REGISTER_PER_IP_HOUR=30
LOG_LEVEL=info
# Go 内存软上限，配合 compose 里 server 的 512m 硬限制
GOMEMLIMIT=400MiB

# 西财校园网出口 IP（CIDR，逗号分隔）。留空 = 只能用邀请码注册
CAMPUS_CIDRS=
# 只信任来自该地址的 X-Real-IP：docker-compose 里 nginx 的固定地址（裁决 #4-3）。
# 合并 .env.example 冲突时以 /32 为准，不要改回 172.16.0.0/12；改了 compose 网段要同步改这里。
TRUSTED_PROXY=172.28.0.10/32

# ---- deploy（docker-compose 用） ----
# 对外 HTTPS 端口，记得在云厂商安全组放行
PUBLIC_PORT=8443
# 镜像源，拉不动时替换（见 deploy/README.md）
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
SERVER_IMAGE=ghcr.io/isaninebug/swufe-homework-server:latest

# ---- worker（只在你的电脑上，放在 worker 可执行文件同目录；说明见 worker/README.md） ----
SERVER_URL=https://YOUR_SERVER_IP:8443/api/v1
# 与 server 段的 WORKER_TOKEN 相同（≥ 24 位）；服务器不设 WORKER_TOKEN 则 AI 始终离线
# WORKER_TOKEN=
SERVER_CERT_PIN=sha256/CHANGE_ME
# OpenAI 兼容地址，到 /v1 为止
LLM_BASE_URL=CHANGE_ME
LLM_API_KEY=CHANGE_ME
LLM_MODEL=deepseek-v4.1-flash
# 只用于访问模型，连服务器不走代理
HTTPS_PROXY=
# 可选：只在这个时段在线（整点，含起不含止），留空 = 一直在线
ACTIVE_HOURS=
# 可选：同时处理的任务数（1–8，默认 2）；模型接口不支持 response_format=json_object 时设 off
WORKER_CONCURRENCY=2
LLM_JSON_MODE=on
